/*
 * lavender (Redmi Note 7, SDM660): kernel log over USB.
 *
 * Replaces the base series' CDC-ECM function with one vendor interface that Windows binds to
 * WinUSB by itself (Microsoft OS 2.0 descriptors), so the PC needs no driver:
 *   bulk IN  0x81  the console log ring, from the first boot message on
 *   bulk OUT 0x01  one text command per packet: "lv:ping", "lv:reset" (boots the installed
 *                  system), "lv:fastboot" (reboots into the bootloader), "lv:shot" (the
 *                  framebuffer: a text line "@@LVSHOT width height stride bytes@@" in the log,
 *                  then exactly that many raw bytes, x8r8g8b8)
 * The PC side is tools/usblog.py.
 *
 * The controller is the Synopsys DWC3 at 0x0a800000 that ABL has just used for fastboot: it is
 * powered, clocked, in device mode and halted, with the PHY set up. Only the device controller is
 * restarted (soft reset, our event buffer, endpoint 0, run). Events are polled from a kernel
 * thread. Register use follows the DWC3 databook as in Linux drivers/usb/dwc3 (gadget.c, ep0.c)
 * and the base series' driver for other Qualcomm phones.
 */
#if defined(ARM64_BOARD_CONFIG_SWEET)
#include <sys/param.h>
#include <sys/systm.h>
#include <kern/clock.h>
#include <kern/thread.h>
#include <kern/sched_prim.h>
#include <machine/machine_routines.h>
#include <arm/caches_internal.h>
#include <vm/pmap.h>
#include <vm/vm_kern.h>
#include <pexpert/pexpert.h>
#include <pexpert/device_tree.h>

extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
void sweet_usb_probe(void);

#define GCC_PA                  0x00100000
#define GCC_SIZE                0x00090000
#define GCC_USB30_GDSCR         0x0f004         /* bit 31: power on */
#define DWC3_PA                 0x0a800000
#define DWC3_SIZE               0x0000d000
#define QSCRATCH_PA             0x0a8f8800      /* Qualcomm wrapper, core base + 0xf8800 */
#define QSCRATCH_HS_PHY_CTRL    0x10
#define   UTMI_OTG_VBUS_VALID   (1u << 20)
#define   SW_SESSVLD_SEL        (1u << 28)
#define QSCRATCH_SS_PHY_CTRL    0x30
#define   LANE0_PWR_PRESENT     (1u << 24)

#define GCTL            0xc110
#define GSNPSID         0xc120
#define GEVNTADRLO      0xc400
#define GEVNTADRHI      0xc404
#define GEVNTSIZ        0xc408
#define GEVNTCOUNT      0xc40c
#define DCFG            0xc700
#define DCTL            0xc704
#define DEVTEN          0xc708
#define DSTS            0xc70c
#define DALEPENA        0xc720
#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
#define DEPCMD(n)       (0xc80c + 0x10 * (n))

#define DCTL_RUN_STOP   (1u << 31)
#define DCTL_CSFTRST    (1u << 30)
#define DSTS_DEVCTRLHLT (1u << 22)

#define DEPCMD_SETEPCONFIG      1
#define DEPCMD_SETTRANSFRESOURCE 2
#define DEPCMD_SETSTALL         4
#define DEPCMD_STARTTRANSFER    6
#define DEPCMD_ENDTRANSFER      8
#define DEPCMD_DEPSTARTCFG      9
#define DEPCMD_CMDACT           (1u << 10)
#define DEPCMD_HIPRI_FORCERM    (1u << 11)

#define TRB_HWO         (1u << 0)
#define TRB_LST         (1u << 1)
#define TRB_ISP_IMI     (1u << 10)
#define TRB_IOC         (1u << 11)
#define TRBCTL_NORMAL   (1u << 4)
#define TRBCTL_SETUP    (2u << 4)
#define TRBCTL_STATUS2  (3u << 4)
#define TRBCTL_STATUS3  (4u << 4)
#define TRBCTL_DATA     (5u << 4)

/* DMA area layout */
#define UD_EVT          0x0000          /* event buffer, 4 KiB */
#define UD_EVT_SIZE     0x1000
#define UD_TRB_OUT      0x1000          /* ep0 OUT TRB */
#define UD_TRB_IN       0x1010          /* ep0 IN TRB */
#define UD_TRB_RX       0x1020          /* bulk OUT TRB */
#define UD_TRB_TX       0x1030          /* bulk IN TRB */
#define UD_SETUP        0x1040          /* 8-byte setup packet */
#define UD_DATA         0x1100          /* ep0 data stage, 512 bytes */
#define UD_RX           0x2000          /* one received command */
#define UD_TX           0x2800          /* one chunk of log */
#define UD_BUF_MAX      0x800
#define UD_SIZE         0x4000
#define UD_LOG_CHUNK    1000u

/* Physical endpoints: 2n = OUT, 2n+1 = IN */
#define EP_RX           2               /* 0x01 bulk OUT */
#define EP_TX           3               /* 0x81 bulk IN */

#define MS_VENDOR_CODE  @VENDOR@

/* VID 0x1209 / PID 0x0005: pid.codes test ID, not a product. bcdUSB 2.01 so the host asks for the BOS. */
static const uint8_t ud_dev_desc[@DEVN@] = {
@DEV@
};
/* One vendor interface, bulk IN 0x81 and bulk OUT 0x01, 512 bytes. */
static const uint8_t ud_cfg_desc[@CFGN@] = {
@CFG@
};
/* BOS with the Microsoft OS 2.0 platform capability: where to fetch the descriptor set below. */
static const uint8_t ud_bos_desc[@BOSN@] = {
@BOS@
};
/* Microsoft OS 2.0 set: compatible ID "WINUSB" and DeviceInterfaceGUIDs @GUID@ */
static const uint8_t ud_msos_desc[@MSOSN@] = {
@MSOS@
};
static const char *const ud_strings[] = {
	NULL, "ios-lavender", "iOS on lavender (kernel log)", "0001",
};

static struct {
	vm_offset_t dwc;
	vm_offset_t dma;
	uint64_t    dma_pa;
	uint32_t    evt_pos;
	int         sleep_chan;
	enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS } state;
	bool        data_in;            /* data stage direction */
	bool        configured;
	bool        tx_busy;
	uint32_t    resource[4];        /* transfer resource index per physical endpoint */
	uint64_t    log_pos;
	uint64_t    tx_bytes;
	bool        shot_pending;
	uint64_t    shot_pa, shot_left;     /* framebuffer bytes still to send */
} ud;

static uint32_t
usb_rd(vm_offset_t base, uint32_t off)
{
	uint32_t v = *(volatile uint32_t *)(base + off);
	__asm__ volatile ("dmb oshld" ::: "memory");
	return v;
}

static inline void
dwc_wr(uint32_t off, uint32_t v)
{
	*(volatile uint32_t *)(ud.dwc + off) = v;
	__asm__ volatile ("dsb sy" ::: "memory");
}

static inline uint32_t
dwc_rd(uint32_t off)
{
	return usb_rd(ud.dwc, off);
}

/* DMA here is not cache coherent: clean and invalidate around every transfer. */
static void
ud_sync(uint32_t off, uint32_t len)
{
	flush_dcache64((addr64_t)(ud.dma_pa + off), len, TRUE);
}

static void
ud_sleep_ms(unsigned ms)
{
	uint64_t deadline;
	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
	thread_block(THREAD_CONTINUE_NULL);
}

static int
ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
{
	dwc_wr(DEPCMDPAR0(ep), p0);
	dwc_wr(DEPCMDPAR1(ep), p1);
	dwc_wr(DEPCMDPAR2(ep), p2);
	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
	for (int i = 0; i < 1000; i++) {
		uint32_t v = dwc_rd(DEPCMD(ep));
		if (!(v & DEPCMD_CMDACT)) {
			return ((v >> 12) & 0xf) ? -1 : 0;
		}
		delay(1);
	}
	return -1;
}

/* One TRB (at DMA offset trb) on physical endpoint ep, for the data at physical address bpa. */
static void
ud_start_trb_pa(unsigned ep, uint32_t trb, uint64_t bpa, uint32_t len, uint32_t ctl)
{
	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
	uint64_t tpa = ud.dma_pa + trb;

	t[0] = (uint32_t)bpa;
	t[1] = (uint32_t)(bpa >> 32);
	t[2] = len;
	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
	ud_sync(trb, 16);
	if (ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0) == 0 && ep < 4) {
		ud.resource[ep] = (dwc_rd(DEPCMD(ep)) >> 16) & 0x7f;
	}
}

/* The same for a buffer inside our DMA area (offset buf). */
static void
ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
{
	if (len) {
		ud_sync(buf, len);
	}
	ud_start_trb_pa(ep, trb, ud.dma_pa + buf, len, ctl);
}

static void
ud_start_ep0(unsigned ep, uint32_t buf, uint32_t len, uint32_t ctl)
{
	ud_start_trb(ep, ep ? UD_TRB_IN : UD_TRB_OUT, buf, len, ctl);
}

static void
ud_start_setup(void)
{
	ud.state = EP0_SETUP;
	ud_start_ep0(0, UD_SETUP, 8, TRBCTL_SETUP);
}

static void
ud_stall(void)
{
	(void)ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
	ud_start_setup();
}

static uint32_t
ud_string(unsigned idx, uint8_t *out)
{
	if (idx == 0) {
		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;   /* en-US */
		return 4;
	}
	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
		return 0;
	}
	const char *str = ud_strings[idx];
	uint32_t n = 2;
	for (; *str && n < 126; str++) {
		out[n++] = (uint8_t)*str;
		out[n++] = 0;
	}
	out[0] = (uint8_t)n;
	out[1] = 3;
	return n;
}

static void
ud_rx_arm(void)
{
	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_BUF_MAX, TRBCTL_NORMAL);
}

/* SET_CONFIGURATION(1): the two bulk endpoints. */
static void
ud_configure(void)
{
	if (ud.configured) {
		return;
	}
	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0) ||
	    ud_epcmd(EP_RX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3), (1u << 8) | ((uint32_t)EP_RX << 25), 0) ||
	    ud_epcmd(EP_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
	    ud_epcmd(EP_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3) | (1u << 17), (1u << 8) | ((uint32_t)EP_TX << 25), 0) ||
	    ud_epcmd(EP_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
		printf("LV USB: bulk endpoint setup failed\n");
		return;
	}
	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_RX) | (1u << EP_TX));
	ud.configured = true;
	ud.tx_busy = false;
	ud_rx_arm();
	printf("LV USB: configured by the host\n");
}

/* Bus reset or disconnect: drop what was queued; the host configures again later. */
static void
ud_unconfigure(void)
{
	if (!ud.configured) {
		return;
	}
	for (unsigned ep = EP_RX; ep <= EP_TX; ep++) {
		dwc_wr(DEPCMD(ep), DEPCMD_ENDTRANSFER | DEPCMD_HIPRI_FORCERM | (ud.resource[ep] << 16) | DEPCMD_CMDACT);
		for (int i = 0; i < 1000 && (dwc_rd(DEPCMD(ep)) & DEPCMD_CMDACT); i++) {
			delay(1);
		}
	}
	dwc_wr(DALEPENA, 0x3);
	ud.configured = false;
	ud.tx_busy = false;
}

static void
ud_setup(void)
{
	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
	uint8_t type = st[0], req = st[1];
	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
	uint32_t n = 0;
	bool ok = true;

	ud.data_in = (type & 0x80) != 0;
	if ((type & 0x60) == 0x40) {    /* vendor: the Microsoft OS 2.0 descriptor set */
		if (ud.data_in && req == MS_VENDOR_CODE && index == 7) {
			memcpy(data, ud_msos_desc, sizeof(ud_msos_desc));
			n = sizeof(ud_msos_desc);
		} else {
			ok = false;
		}
	} else if ((type & 0x60) != 0) {
		ok = false;
	} else if (req == 6) {          /* GET_DESCRIPTOR */
		switch (value >> 8) {
		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
		case 2: memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc)); n = sizeof(ud_cfg_desc); break;
		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
		case 15: memcpy(data, ud_bos_desc, sizeof(ud_bos_desc)); n = sizeof(ud_bos_desc); break;
		default: ok = false; break;
		}
	} else if (req == 5) {          /* SET_ADDRESS: takes effect now (DWC3 handles the timing) */
		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
	} else if (req == 9) {          /* SET_CONFIGURATION */
		if (value == 1) {
			ud_configure();
		}
	} else if (req == 8) {          /* GET_CONFIGURATION */
		data[0] = ud.configured ? 1 : 0; n = 1;
	} else if (req == 0) {          /* GET_STATUS */
		data[0] = 0; data[1] = 0; n = 2;
	} else if (req == 10) {         /* GET_INTERFACE */
		data[0] = 0; n = 1;
	} else if (req == 1 || req == 3 || req == 11) { /* CLEAR/SET_FEATURE, SET_INTERFACE */
	} else {
		ok = false;
	}
	if (!ok) {
		ud_stall();
		return;
	}
	if (length == 0) {
		ud.state = EP0_WAIT_STATUS2;    /* status stage on XferNotReady */
		return;
	}
	ud.state = EP0_DATA;
	if (ud.data_in) {
		if (n > length) {
			n = length;
		}
		ud_start_ep0(1, UD_DATA, n, TRBCTL_DATA);
	} else {
		ud_start_ep0(0, UD_DATA, 64, TRBCTL_DATA);      /* OUT data is not used here */
	}
}

/*
 * "Reboot to bootloader" the way Linux does it on this phone (msm-poweroff.c, qpnp-power-on.c):
 * restart reason BOOTLOADER in the PM660's PON block, PS_HOLD reset type WARM, then PS_HOLD low.
 * ABL reads the reason and stays in fastboot. (PSCI SYSTEM_RESET is a cold reset: the reason is lost.)
 *
 * The PMIC is reached through the SPMI arbiter (DT qcom,spmi@800f000, arbiter v3): a table maps
 * each peripheral (slave id, address high byte) to a channel; writes go through the channel's
 * registers at chnls + 0x8000 * channel, reads through the observer block.
 */
#define SPMI_CORE_PA    0x0800f000u     /* +0x800: channel -> peripheral table, bits 19:8 */
#define SPMI_CNFG_PA    0x0800a000u     /* +0x700: channel owner, bits 2:0 (0 = the application CPU) */
#define SPMI_CHNLS_PA   0x08400000u
#define SPMI_OBSRVR_PA  0x09400000u
#define SPMI_CMD        0x00            /* opcode << 27 | register << 4; 0 = write, 1 = read (one byte) */
#define SPMI_STATUS     0x08            /* bit 0 done, bits 3:1 failure / denied / dropped */
#define SPMI_WDATA      0x10
#define SPMI_RDATA      0x18
#define PON_SOFT_RB_SPARE       0x88f   /* restart reason in bits 7:1 */
#define PON_PS_HOLD_RST_CTL     0x85a   /* reset type in bits 3:0, 1 = warm */
#define PON_PS_HOLD_RST_CTL2    0x85b   /* bit 7: reset enabled */
#define PON_REASON_BOOTLOADER   2
#define PS_HOLD_PA      0x010ac000u     /* DT restart@10ac000 */

static int
spmi_channel(unsigned peripheral)
{
	static vm_offset_t core, cnfg;
	int found = -1;

	if (core == 0) {
		core = ml_io_map(SPMI_CORE_PA, 0x1000);
		cnfg = ml_io_map(SPMI_CNFG_PA, 0x1000);
	}
	if (core == 0 || cnfg == 0) {
		return -1;
	}
	for (unsigned i = 0; i < 512; i++) {
		uint32_t map = usb_rd(core, 0x800 + 4 * i);
		if (map == 0 || ((map >> 8) & 0xfff) != peripheral) {
			continue;
		}
		if (found < 0 || (usb_rd(cnfg, 0x700 + 4 * i) & 7) == 0) {
			found = (int)i;         /* prefer the channel we own */
		}
	}
	return found;
}

/* One byte of PMIC 0 at addr. Returns 0 on success. */
static int
spmi_byte(bool write, unsigned addr, uint8_t *val)
{
	int channel = spmi_channel(addr >> 8);
	if (channel < 0) {
		return -1;
	}
	vm_offset_t ch = ml_io_map((write ? SPMI_CHNLS_PA : SPMI_OBSRVR_PA) + 0x8000u * (uint32_t)channel, 0x1000);
	if (ch == 0) {
		return -1;
	}
	if (write) {
		*(volatile uint32_t *)(ch + SPMI_WDATA) = *val;
		__asm__ volatile ("dsb sy" ::: "memory");
	}
	*(volatile uint32_t *)(ch + SPMI_CMD) = ((write ? 0u : 1u) << 27) | ((addr & 0xffu) << 4);
	__asm__ volatile ("dsb sy" ::: "memory");
	for (int i = 0; i < 1000; i++) {
		uint32_t st = usb_rd(ch, SPMI_STATUS);
		if (st & 1) {
			if (st & 0xe) {
				return -2;
			}
			if (!write) {
				*val = (uint8_t)usb_rd(ch, SPMI_RDATA);
			}
			return 0;
		}
		delay(1);
	}
	return -3;
}

/* Read, change the masked bits, write back. */
static int
spmi_update(unsigned addr, uint8_t mask, uint8_t bits)
{
	uint8_t v = 0;
	int r = spmi_byte(false, addr, &v);
	if (r == 0) {
		v = (uint8_t)((v & ~mask) | bits);
		r = spmi_byte(true, addr, &v);
	}
	return r;
}

static void
ud_reboot_bootloader(void)
{
	int r = spmi_update(PON_SOFT_RB_SPARE, 0xfe, (uint8_t)(PON_REASON_BOOTLOADER << 1));
	if (r == 0) {
		r = spmi_update(PON_PS_HOLD_RST_CTL2, 0x80, 0);         /* off while the type changes */
		delay(500);
	}
	if (r == 0) {
		r = spmi_update(PON_PS_HOLD_RST_CTL, 0x0f, 1);          /* warm reset */
	}
	if (r == 0) {
		r = spmi_update(PON_PS_HOLD_RST_CTL2, 0x80, 0x80);
		delay(500);
	}
	printf("LV USB: restart reason bootloader: %s (%d)\n", r == 0 ? "set" : "FAILED", r);
	vm_offset_t ps = r == 0 ? ml_io_map(PS_HOLD_PA, 0x1000) : 0;
	if (ps != 0) {
		*(volatile uint32_t *)ps = 0;                           /* PS_HOLD low: the PMIC resets the phone */
		__asm__ volatile ("dsb sy" ::: "memory");
		delay(2000000);
	}
	printf("LV USB: still running, the phone was not reset\n");
}

/* PSCI SYSTEM_RESET: a cold reset, the phone then boots its installed system. */
static void
ud_system_reset(void)
{
	register uint64_t x0 __asm__("x0") = 0x84000009ULL;
	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
}

/* One command per bulk OUT packet. */
static void
ud_rx_done(void)
{
	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
	char cmd[32];

	ud_sync(UD_TRB_RX, 16);
	uint32_t len = UD_BUF_MAX - (t[2] & 0xffffff);
	ud_sync(UD_RX, UD_BUF_MAX);
	if (len >= sizeof(cmd)) {
		len = sizeof(cmd) - 1;
	}
	memcpy(cmd, (const void *)(ud.dma + UD_RX), len);
	while (len > 0 && (cmd[len - 1] == '\n' || cmd[len - 1] == '\r' || cmd[len - 1] == ' ')) {
		len--;
	}
	cmd[len] = 0;
	ud_rx_arm();
	if (strcmp(cmd, "lv:ping") == 0) {
		printf("LV USB: pong, %llu log bytes sent\n", ud.tx_bytes);
	} else if (strcmp(cmd, "lv:reset") == 0) {
		printf("LV USB: reset requested by the host\n");
		ud_system_reset();
	} else if (strcmp(cmd, "lv:fastboot") == 0) {
		ud_reboot_bootloader();
	} else if (strcmp(cmd, "lv:shot") == 0) {
		ud.shot_pending = true;
	} else {
		printf("LV USB: unknown command \"%s\"\n", cmd);
	}
}

/*
 * lv:shot: the panel's framebuffer (/sweet-fbcon in the device tree) goes out by DMA straight from
 * its physical address, 1 MiB per transfer, after a text header in the log stream.
 */
static bool
ud_tx_shot(void)
{
	if (ud.shot_pending) {
		DTEntry node;
		uint64_t const *reg = NULL;
		uint32_t const *w = NULL, *h = NULL, *stride = NULL;
		unsigned int size = 0;
		ud.shot_pending = false;
		if (SecureDTLookupEntry(NULL, "/sweet-fbcon", &node) != kSuccess ||
		    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess || size < 16 ||
		    SecureDTGetProperty(node, "width", (void const **)&w, &size) != kSuccess ||
		    SecureDTGetProperty(node, "height", (void const **)&h, &size) != kSuccess ||
		    SecureDTGetProperty(node, "stride", (void const **)&stride, &size) != kSuccess) {
			printf("LV USB: no /sweet-fbcon for lv:shot\n");
			return false;
		}
		ud.shot_pa = reg[0];
		ud.shot_left = (uint64_t)*stride * *h;
		uint32_t n = (uint32_t)snprintf((char *)(ud.dma + UD_TX), UD_BUF_MAX, "\n@@LVSHOT %u %u %u %llu@@\n",
		    *w, *h, *stride, ud.shot_left);
		ud.tx_busy = true;
		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, n, TRBCTL_NORMAL);
		return true;
	}
	if (ud.shot_left == 0) {
		return false;
	}
	uint32_t n = (uint32_t)MIN(ud.shot_left, 1ull << 20);
	flush_dcache64((addr64_t)ud.shot_pa, n, TRUE);
	ud.tx_busy = true;
	ud_start_trb_pa(EP_TX, UD_TRB_TX, ud.shot_pa, n, TRBCTL_NORMAL);
	ud.shot_pa += n;
	ud.shot_left -= n;
	return true;
}

/* Send the next piece of the console log (or of a screenshot) if the IN endpoint is idle. */
static void
ud_tx_log(void)
{
	if (!ud.configured || ud.tx_busy || ud_tx_shot()) {
		return;
	}
	uint32_t n = sweet_log_copy(&ud.log_pos, (char *)(ud.dma + UD_TX), UD_LOG_CHUNK);
	if (n == 0) {
		return;
	}
	if ((n % 512) == 0) {           /* a full last packet would need a zero-length packet after it */
		n--;
		ud.log_pos--;
	}
	ud.tx_busy = true;
	ud.tx_bytes += n;
	ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, n, TRBCTL_NORMAL);
}

static void
ud_event(uint32_t ev)
{
	if (ev & 1) {                   /* device event */
		uint32_t type = (ev >> 8) & 0xf;
		if (type == 1) {        /* USB reset */
			ud_unconfigure();
			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
		} else if (type == 2) { /* connect done: ep0 max packet 64 at high/full speed */
			(void)ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
			    (1u << 8) | (1u << 10) | (0u << 25), 0);
			(void)ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
			    (1u << 8) | (1u << 10) | (1u << 25), 0);
			printf("LV USB: connected, speed %u\n", dwc_rd(DSTS) & 7);
		} else if (type == 0) {
			ud_unconfigure();
		}
		return;
	}
	unsigned ep = (ev >> 1) & 0x1f;
	unsigned type = (ev >> 6) & 0xf;
	unsigned status = (ev >> 12) & 0xf;

	if (ep == EP_RX) {
		if (type == 1) {
			ud_rx_done();
		}
		return;
	}
	if (ep == EP_TX) {
		if (type == 1) {
			ud.tx_busy = false;
		}
		return;
	}
	if (ep > 1) {
		return;
	}
	/*
	 * Control transfers: SETUP completes -> the request is handled and the data stage, if any,
	 * started at once; the status stage is started when the controller reports XferNotReady
	 * with status "control status"; its completion re-arms SETUP.
	 */
	if (type == 1) {                /* XferComplete */
		switch (ud.state) {
		case EP0_SETUP:
			ud_sync(UD_SETUP, 8);
			ud_setup();
			break;
		case EP0_DATA:
			ud.state = EP0_WAIT_STATUS3;
			break;
		case EP0_STATUS:
			ud_start_setup();
			break;
		default:
			break;
		}
		return;
	}
	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
			ud.state = EP0_STATUS;
			ud_start_ep0(ep, UD_DATA, 0, ctl);
		}
	}
}

static void
ud_thread(void *arg __unused, wait_result_t wr __unused)
{
	for (;;) {
		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
		if (count) {
			ud_sync(UD_EVT, UD_EVT_SIZE);
			for (uint32_t done = 0; done < count; done += 4) {
				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
				ud_event(ev);
			}
			dwc_wr(GEVNTCOUNT, count);
		}
		ud_tx_log();
		ud_sleep_ms(1);
	}
}

static void
ud_gadget_start(void)
{
	thread_t thread;
	int i;

	if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
		printf("LV USB: no DMA memory\n");
		return;
	}
	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ud.dma);
	if (!pn) {
		return;
	}
	ud.dma_pa = ptoa_64(pn);

	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
	dwc_wr(DCTL, DCTL_CSFTRST);
	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
		delay(1000);
	}
	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
		printf("LV USB: soft reset stuck, GCTL 0x%08x\n", dwc_rd(GCTL));
		return;
	}

	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
	ud.evt_pos = 0;

	dwc_wr(DCFG, dwc_rd(DCFG) & ~(7u | (0x7fu << 3)));      /* high speed, address 0 */
	dwc_wr(DEVTEN, 0x7);                                    /* disconnect, USB reset, connect done */

	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
		printf("LV USB: endpoint 0 setup failed\n");
		return;
	}
	dwc_wr(DALEPENA, 0x3);
	ud_start_setup();

	/* The controller only connects while it sees a VBUS session: force it, as Linux dwc3-qcom does. */
	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
	if (qs != 0) {
		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
		*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
		*(volatile uint32_t *)(qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
		__asm__ volatile ("dsb sy" ::: "memory");
	}

	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
		delay(1000);
	}
	printf("LV USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
	if (kernel_thread_start(ud_thread, NULL, &thread) == KERN_SUCCESS) {
		thread_deallocate(thread);
	}
}

/* Boot-arg lvusb=0 turns the USB log off (default on). */
void
sweet_usb_probe(void)
{
	static bool started;
	int enabled = 1;

	PE_parse_boot_argn("lvusb", &enabled, sizeof(enabled));
	if (!enabled || started) {
		return;
	}
	started = true;
	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
	ud.dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
	if (gcc == 0 || ud.dwc == 0) {
		printf("LV USB: map failed\n");
		return;
	}
	printf("LV USB: GDSC 0x%08x, DWC3 id 0x%08x GCTL 0x%08x DCTL 0x%08x DSTS 0x%08x\n",
	    usb_rd(gcc, GCC_USB30_GDSCR), dwc_rd(GSNPSID), dwc_rd(GCTL), dwc_rd(DCTL), dwc_rd(DSTS));
	ud_gadget_start();
}
#endif /* ARM64_BOARD_CONFIG_SWEET */
