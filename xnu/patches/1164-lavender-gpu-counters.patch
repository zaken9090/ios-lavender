index e27a034..aa39a52 100644
--- a/iokit/Kernel/arm/LavenderMetrics.cpp
+++ b/iokit/Kernel/arm/LavenderMetrics.cpp
@@ -48,6 +48,7 @@ extern unsigned int lvm_level __asm("_memorystatus_level");
 }
 
 /* TopazAdreno.cpp */
+extern "C" bool redwood_gpu_counters(uint64_t *out, uint32_t count);
 extern "C" bool redwood_gpu_stats(uint64_t *busy, uint32_t *mhz, uint32_t *submits, uint32_t *recovered, uint32_t *failed);
 
 static volatile uint32_t *tm, *pll_gold, *pll_silver, *gold_rcg, *apcs_common;
@@ -372,6 +373,26 @@ metrics_thread(__unused void *arg, __unused wait_result_t w)
 		if (ns != 0) {
 			IOLog("%s\n", line);
 		}
+		{
+			/* the GPU's own counters, as the change over the period (xnu/src/mk_gpucounters.py) */
+			static uint64_t was[14];
+			static bool had;
+			uint64_t c[14], d[14];
+			if (redwood_gpu_counters(c, 14)) {
+				for (int i = 0; i < 14; i++) {
+					d[i] = c[i] >= was[i] ? c[i] - was[i] : 0;      /* (a GPU reset starts them again) */
+					was[i] = c[i];
+				}
+				if (had && ns != 0) {
+					IOLog("LVG %llu ms: tpbeat %llu spbeat %llu latcyc %llu latn %llu | tpbusy %llu tpreq %llu tpmiss %llu | "
+					    "spalu %llu spbusy %llu spidle %llu | rbbusy %llu rbpass %llu rbstall %llu rbfifo %llu\n", ns / 1000000,
+					    d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9], d[10], d[11], d[12], d[13]);
+				}
+				had = true;
+			} else {
+				had = false;
+			}
+		}
 		if (top_n != 0) {
 			proc_line(ns);
 		}
