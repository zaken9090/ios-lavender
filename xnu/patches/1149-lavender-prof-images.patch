+static int
+lvp_image_index(vm_map_t map, uint64_t pc)
+{
+	uint64_t page = pc & ~0x3fffull;
+	unsigned h = (unsigned)((page >> 14) % 4096);
+	if (lvp_cpage[h] == page) {
+		return lvp_cimg[h];
+	}
+	char nm[40];
+	uint64_t base = lvp_image(map, pc, nm, sizeof(nm));
+	int i;
+	for (i = 1; i < LVP_IMGS && lvp_img[i].base != 0 && lvp_img[i].base != base; i++) {
+	}
+	if (i == LVP_IMGS) {
+		i = 0;                                  /* (index 0: anything else) */
+	} else if (lvp_img[i].base == 0) {
+		lvp_img[i].base = base ? base : 1;
+		strlcpy(lvp_img[i].name, base ? nm : "(no image)", sizeof(lvp_img[i].name));
+	}
+	lvp_cpage[h] = page;
+	lvp_cimg[h] = (uint16_t)i;
+	return i;
