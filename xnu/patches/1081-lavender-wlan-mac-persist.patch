+/* ---------------- read-only ext4 on a partition, for persist's wlan_mac.bin (mk_wlanmac.py) */
+struct e4 {
+	const char *part;
+	uint32_t bs, ipg, isz, dsz;
+	uint64_t gdt;
+};
+
+static bool
+e4_rd(struct e4 *f, uint64_t off, void *dst, uint32_t len)
+{
+	return sweet_ufs_read_part(f->part, off, dst, len) == 0;
+}
+
+/* the 15 i_block words and size of inode ino */
+static bool
+e4_inode(struct e4 *f, uint32_t ino, uint32_t *blk, uint64_t *size, uint32_t *flags, uint16_t *mode)
+{
+	uint8_t gd[64], in[160];
+	uint32_t g = (ino - 1) / f->ipg, idx = (ino - 1) % f->ipg;
+	if (!e4_rd(f, f->gdt + (uint64_t)g * f->dsz, gd, f->dsz > 64 ? 64 : f->dsz)) {
+		return false;
+	}
+	uint64_t itab = gd[8] | (gd[9] << 8) | (gd[10] << 16) | ((uint64_t)gd[11] << 24);
+	if (f->dsz >= 64) {
+		itab |= (uint64_t)(gd[0x28] | (gd[0x29] << 8) | (gd[0x2a] << 16) | ((uint32_t)gd[0x2b] << 24)) << 32;
+	}
+	if (!e4_rd(f, itab * f->bs + (uint64_t)idx * f->isz, in, sizeof(in))) {
+		return false;
+	}
+	*mode = (uint16_t)(in[0] | (in[1] << 8));
+	*size = (uint64_t)(in[4] | (in[5] << 8) | (in[6] << 16) | ((uint32_t)in[7] << 24)) |
+	    ((uint64_t)(in[108] | (in[109] << 8) | (in[110] << 16) | ((uint32_t)in[111] << 24)) << 32);
+	*flags = in[32] | (in[33] << 8) | (in[34] << 16) | ((uint32_t)in[35] << 24);
+	memcpy(blk, in + 40, 60);
+	return true;
+}
+
+/* physical block of logical block lb, 0 if none (extent depth 0 or direct blocks only) */
+static uint64_t
+e4_map(const uint32_t *blk, uint32_t flags, uint32_t lb)
+{
+	if (flags & 0x80000) {
+		const uint8_t *h = (const uint8_t *)blk;
+		uint16_t magic = h[0] | (h[1] << 8), n = h[2] | (h[3] << 8), depth = h[6] | (h[7] << 8);
+		if (magic != 0xF30A || depth != 0) {
+			return 0;
+		}
+		for (uint16_t i = 0; i < n && i < 4; i++) {
+			const uint8_t *e = h + 12 + 12 * i;
+			uint32_t first = e[0] | (e[1] << 8) | (e[2] << 16) | ((uint32_t)e[3] << 24);
+			uint16_t cnt = (uint16_t)((e[4] | (e[5] << 8)) & 0x7fff);
+			uint64_t start = ((uint64_t)(e[6] | (e[7] << 8)) << 32) | (e[8] | (e[9] << 8) | (e[10] << 16) | ((uint32_t)e[11] << 24));
+			if (lb >= first && lb < first + cnt) {
+				return start + (lb - first);
+			}
+		}
+		return 0;
+	}
+	return lb < 12 ? blk[lb] : 0;
+}
+
+/* inode of name in directory dino, 0 if absent (up to 16 blocks of directory) */
+static uint32_t
+e4_lookup(struct e4 *f, uint32_t dino, const char *name, uint32_t *subdirs, unsigned *nsub, unsigned maxsub)
+{
+	uint32_t blk[15], flags;
+	uint64_t size;
+	uint16_t mode;
+	uint32_t found = 0;
+	if (!e4_inode(f, dino, blk, &size, &flags, &mode)) {
+		return 0;
+	}
+	uint8_t *b = (uint8_t *)IOMallocData(f->bs);
+	if (b == NULL) {
+		return 0;
+	}
+	for (uint32_t lb = 0; lb < 16 && (uint64_t)lb * f->bs < size && !found; lb++) {
+		uint64_t pb = e4_map(blk, flags, lb);
+		if (pb == 0 || !e4_rd(f, pb * f->bs, b, f->bs)) {
+			break;
+		}
+		for (uint32_t o = 0; o + 8 <= f->bs;) {
+			uint32_t ino = b[o] | (b[o + 1] << 8) | (b[o + 2] << 16) | ((uint32_t)b[o + 3] << 24);
+			uint16_t rl = (uint16_t)(b[o + 4] | (b[o + 5] << 8));
+			uint8_t nl = b[o + 6], ft = b[o + 7];
+			if (rl < 8 || o + rl > f->bs) {
+				break;
+			}
+			if (ino != 0 && nl != 0 && o + 8 + nl <= f->bs) {
+				if (nl == strlen(name) && memcmp(b + o + 8, name, nl) == 0) {
+					found = ino;
+					break;
+				}
+				bool dot = (nl == 1 && b[o + 8] == '.') || (nl == 2 && b[o + 8] == '.' && b[o + 9] == '.');
+				if (ft == 2 && !dot && subdirs != NULL && *nsub < maxsub) {
+					subdirs[(*nsub)++] = ino;
+				}
+			}
+			o += rl;
+		}
+	}
+	IOFreeData(b, f->bs);
+	return found;
+}
+
+/* persist's wlan_mac.bin -> our_mac; false (address unchanged) when not found */
+static bool
+wlan_mac_from_persist(void)
+{
+	struct e4 f = { "persist", 0, 0, 0, 32, 0 };
+	uint8_t sb[256];
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("modem_mac", &on, sizeof(on));
+	if (on == 0) {
+		return false;
+	}
+	if (!e4_rd(&f, 1024, sb, sizeof(sb)) || (sb[56] | (sb[57] << 8)) != 0xEF53) {
+		LOG("wlan mac: persist is not ext4 (or unreadable)");
+		return false;
+	}
+	uint32_t logbs = sb[24] | (sb[25] << 8) | (sb[26] << 16) | ((uint32_t)sb[27] << 24);
+	f.bs = 1024u << logbs;
+	f.ipg = sb[40] | (sb[41] << 8) | (sb[42] << 16) | ((uint32_t)sb[43] << 24);
+	f.isz = sb[88] | (sb[89] << 8);
+	uint32_t incompat = sb[96] | (sb[97] << 8) | (sb[98] << 16) | ((uint32_t)sb[99] << 24);
+	if (incompat & 0x80) {
+		f.dsz = sb[254] | (sb[255] << 8);
+	}
+	if (f.dsz < 32) {
+		f.dsz = 32;
+	}
+	f.gdt = (uint64_t)(f.bs == 1024 ? 2 : 1) * f.bs;
+	if (f.bs > 65536 || f.ipg == 0 || f.isz < 128) {
+		LOG("wlan mac: persist superblock not understood");
+		return false;
+	}
+	uint32_t subs[24];
+	unsigned nsub = 0;
+	uint32_t ino = e4_lookup(&f, 2, "wlan_mac.bin", subs, &nsub, 24);
+	for (unsigned i = 0; ino == 0 && i < nsub; i++) {
+		ino = e4_lookup(&f, subs[i], "wlan_mac.bin", NULL, NULL, 0);
+	}
+	if (ino == 0) {
+		LOG("wlan mac: no wlan_mac.bin on persist (root and %u subfolders)", nsub);
+		return false;
+	}
+	uint32_t blk[15], flags;
+	uint64_t size;
+	uint16_t mode;
+	char txt[257];
+	if (!e4_inode(&f, ino, blk, &size, &flags, &mode) || size == 0 || size > 256) {
+		LOG("wlan mac: wlan_mac.bin unreadable (size %llu)", size);
+		return false;
+	}
+	uint8_t *b = (uint8_t *)IOMallocData(f.bs);
+	uint64_t pb = e4_map(blk, flags, 0);
+	bool ok = b != NULL && pb != 0 && e4_rd(&f, pb * f.bs, b, f.bs);
+	if (ok) {
+		memcpy(txt, b, (size_t)size);
+		txt[size] = 0;
+	}
+	if (b != NULL) {
+		IOFreeData(b, f.bs);
+	}
+	if (!ok) {
+		LOG("wlan mac: wlan_mac.bin unreadable");
+		return false;
+	}
+	uint8_t mac[6];
+	const char *p = strnstr(txt, "Intf0MacAddress=", sizeof(txt));
+	if (p != NULL) {
+		p += 16;
+		for (int i = 0; i < 6; i++) {
+			int v = 0;
+			for (int k = 0; k < 2; k++, p++) {
+				char c = *p;
+				int d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+				if (d < 0) {
+					LOG("wlan mac: Intf0MacAddress not 12 hex digits");
+					return false;
+				}
+				v = v * 16 + d;
+			}
+			mac[i] = (uint8_t)v;
+		}
+	} else if (size == 6) {
+		memcpy(mac, txt, 6);
+	} else {
+		LOG("wlan mac: wlan_mac.bin of %llu bytes, format not known", size);
+		return false;
+	}
+	if ((mac[0] & 1) || (mac[0] | mac[1] | mac[2] | mac[3] | mac[4] | mac[5]) == 0) {
+		LOG("wlan mac: the address in wlan_mac.bin is not usable");
+		return false;
+	}
+	memcpy(our_mac, mac, 6);
+	LOG("wlan mac: %02x:%02x:%02x:**:**:** from persist (read only)", mac[0], mac[1], mac[2]);
+	return true;
+}
