+/* lv:gold while the governor runs: it owns the clock (and the rail) - its range becomes the step at or below l */
+static bool
+cd_pin(uint32_t l)
+{
+	uint32_t to = cd_step[0];
+
+	if (!cd_running) {
+		return false;
