--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -14579,3 +14579,16 @@ fs_snapshot(__unused proc_t p, struct fs_snapshot_args *uap,
 
