+/* lavender (xnu/src/mk_bbfw.py): mkdir of a kernel path, for the installer in bsd/dev/topaz_fw.c */
+int sweet_mkdir(const char *path, int mode);
+
+int
+sweet_mkdir(const char *path, int mode)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, (mode_t)mode);
+	return mkdir1at(vfs_context_kernel(), CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
