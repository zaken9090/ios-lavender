lavender: touch from the host (lv:tap, lv:swipe) for automated tests

- sweet_usb.c: lv:tap X Y, lv:swipe X1 Y1 X2 Y2 MS (panel pixels, finger 9); command buffer 64 bytes
- made by xnu/src/mk_input.py

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 9ee053d..6d57601 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -656,12 +656,60 @@ ud_set_time(const char *arg)
 	clock_set_calendar_microtime((clock_sec_t)secs, 0);
 }
 
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+/* Up to n unsigned decimal numbers from arg; returns how many were read. */
+static int
+ud_numbers(const char *arg, int *v, int n)
+{
+	int got = 0;
+	while (got < n) {
+		while (*arg == ' ') {
+			arg++;
+		}
+		if (*arg < '0' || *arg > '9') {
+			break;
+		}
+		int x = 0;
+		for (; *arg >= '0' && *arg <= '9'; arg++) {
+			x = x * 10 + (*arg - '0');
+		}
+		v[got++] = x;
+	}
+	return got;
+}
+
+/* lv:tap X Y / lv:swipe X1 Y1 X2 Y2 MS: a finger from the host (finger 9). */
+static void
+ud_touch(const char *arg, bool swipe)
+{
+	int v[5] = {0, 0, 0, 0, 0};
+	int need = swipe ? 5 : 2;
+	if (ud_numbers(arg, v, need) != need || v[0] >= 1080 || v[1] >= 2340 ||
+	    (swipe && (v[2] >= 1080 || v[3] >= 2340 || v[4] > 5000))) {
+		printf("LV USB: bad %s\n", swipe ? "lv:swipe" : "lv:tap");
+		return;
+	}
+	sweet_hid_touch(9, 1, v[0], v[1]);
+	if (swipe) {
+		int steps = v[4] / 16 > 0 ? v[4] / 16 : 1;
+		for (int i = 1; i <= steps; i++) {
+			ud_sleep_ms(16);
+			sweet_hid_touch(9, 1, v[0] + (v[2] - v[0]) * i / steps, v[1] + (v[3] - v[1]) * i / steps);
+		}
+		sweet_hid_touch(9, 0, v[2], v[3]);
+	} else {
+		ud_sleep_ms(80);
+		sweet_hid_touch(9, 0, v[0], v[1]);
+	}
+}
+
