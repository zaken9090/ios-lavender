@@ -13,6 +13,42 @@ extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 extern "C" void lv_thermal_start(void);
 
 static volatile uint32_t *tm;
+
+/* osfmk: per-processor tick counters (struct processor_cpu_load_info: user, system, idle, nice) */
+extern "C" void *cpu_to_processor(int cpu);
+extern "C" int processor_info(void *processor, int flavor, void **host, int *info, unsigned int *count);
+extern "C" unsigned int real_ncpus;
+#define LV_MAX_CPUS         8
+static uint32_t last_busy[LV_MAX_CPUS], last_all[LV_MAX_CPUS];
+
+/* busy share in percent since the last call: all cores, and the busiest one */
+static void
+cpu_load(unsigned *all_pct, unsigned *top_pct, int *top_cpu)
+{
+	uint64_t busy = 0, total = 0;
+	*top_pct = 0;
+	*top_cpu = -1;
+	for (unsigned c = 0; c < real_ncpus && c < LV_MAX_CPUS; c++) {
+		void *p = cpu_to_processor((int)c);
+		int t[4] = { 0, 0, 0, 0 };
+		unsigned int n = 4;
+		void *host = NULL;
+		if (p == NULL || processor_info(p, 2 /* PROCESSOR_CPU_LOAD_INFO */, &host, t, &n) != 0) {
+			continue;
+		}
+		uint32_t b = (uint32_t)t[0] + (uint32_t)t[1] + (uint32_t)t[3], a = b + (uint32_t)t[2];
+		uint32_t db = b - last_busy[c], da = a - last_all[c];
+		last_busy[c] = b;
+		last_all[c] = a;
+		busy += db;
+		total += da;
+		if (da != 0 && db * 100 / da >= *top_pct) {
+			*top_pct = db * 100 / da;
+			*top_cpu = (int)c;
+		}
+	}
+	*all_pct = total != 0 ? (unsigned)(busy * 100 / total) : 0;
+}
 static uint32_t period_s = 30;
 
