+int lv_pmic_byte(int write, unsigned addr, uint8_t *val);
+int
+lv_pmic_byte(int write, unsigned addr, uint8_t *val)
+{
+	return spmi_byte(write != 0, addr, val);       /* (spmi_byte: channel of addr >> 8, register addr & 0xff) */
+}
