lavender: Bluetooth UART hardware flow control after the power-on pulse (generator: xnu/src/mk_bt3.py)

diff --git a/iokit/Kernel/arm/LavenderBT.cpp b/iokit/Kernel/arm/LavenderBT.cpp
index e5b22f7..b9e76b4 100644
--- a/iokit/Kernel/arm/LavenderBT.cpp
+++ b/iokit/Kernel/arm/LavenderBT.cpp
@@ -246,6 +246,9 @@ bt_thread(__unused void *arg, __unused wait_result_t w)
 	bt_uart_baud(0xcc);                                      /* 115200: divisor 4 */
 	pulse = 0xFC;
 	bt_put(&pulse, 1);
+	/* flow control on, as Linux does after the pulses (mk_bt3.py): auto RFR at 48 bytes, CTS gates TX */
+	wr(uart, U_MR1, 48u | (1u << 7) | (1u << 6));
+	wr(uart, U_CR, 13u << 4);                               /* SET_RFR */
 	IOSleep(100);
 	bt_drain("after the power-on pulse", 200);
 	uint8_t ver = 0x19;
