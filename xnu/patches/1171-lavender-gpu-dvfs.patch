lavender: GPU clock follows the load, 300 <-> 600 MHz (default on, lv_gpu_dvfs=0 off; generator: xnu/src/mk_gpudvfs.py)

diff --git a/iokit/Kernel/arm/LavenderMetrics.cpp b/iokit/Kernel/arm/LavenderMetrics.cpp
index 7674fdd..edd0ef7 100644
--- a/iokit/Kernel/arm/LavenderMetrics.cpp
+++ b/iokit/Kernel/arm/LavenderMetrics.cpp
@@ -203,6 +203,7 @@ lv_gold_set_l(uint32_t l)
 /* ---- the Gold clock steps down when the chip is hot (xnu/src/mk_thermalguard.py) ---- */
 
 static uint32_t therm_hi = 85, therm_lo;
+extern "C" volatile uint32_t lv_gpu_hot;        /* TopazRpm.cpp GPU DVFS (mk_gpudvfs.py): 1 = hold 300 MHz */
 static bool quiet;                              /* lv_metrics=0: no lines, the guard still runs */
 
 static void
@@ -215,6 +216,11 @@ thermal_guard(int hottest)
 	if (therm_hi == 0 || hottest <= -1000) {
 		return;
 	}
+	if (hottest >= (int)therm_hi) {
+		lv_gpu_hot = 1;
+	} else if (hottest <= (int)therm_lo) {
+		lv_gpu_hot = 0;
+	}
 	if (gold_want == 0) {
 		gold_want = l;
 	}
