lavender: boot-arg sweettouch_trace=1, a line per touch report (generator: xnu/src/mk_touchtrace.py)

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 68b8586..49123b2 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -349,6 +349,10 @@ touch_thread(void *arg __unused, wait_result_t wr __unused)
 	uint64_t session_start = 0;
 	PE_parse_boot_argn("sweettouch_down_ms", &down_ms, sizeof(down_ms));
 	PE_parse_boot_argn("sweettouch_down_max", &down_max, sizeof(down_max));
+	/* lavender: sweettouch_trace=1 (xnu/src/mk_touchtrace.py) */
+	uint32_t trace = 0;
+	uint64_t trace_last = 0;
+	PE_parse_boot_argn("sweettouch_trace", &trace, sizeof(trace));
 	if (down_ms == 0 || down_ms > 8) {
 		down_ms = 1;
 	}
@@ -380,8 +384,24 @@ touch_thread(void *arg __unused, wait_result_t wr __unused)
 		if (due) {
 			quiet = 0;
 			since = 0;
+			uint64_t t_read = mach_absolute_time();
 			if (i2c_read(NVT_ADDR, 0x00, r, NVT_REPORT_LEN) == 0) {
 				lt.reports++;
+				if (trace) {
+					uint64_t t_end = mach_absolute_time(), ns_now, ns_gap = 0, ns_read;
+					absolutetime_to_nanoseconds(t_end, &ns_now);
+					absolutetime_to_nanoseconds(t_end - t_read, &ns_read);
+					if (trace_last != 0) {
+						absolutetime_to_nanoseconds(t_end - trace_last, &ns_gap);
+					}
+					trace_last = t_end;
+					unsigned id = r[0] >> 3, st = r[0] & 7;
+					int x = (r[1] << 4) | (r[3] >> 4), y = (r[2] << 4) | (r[3] & 0x0f);
+					if (st == 1 || st == 2 || any_down) {
+						printf("TT %llu gap %llu read %llu f%u %d,%d st %u\n", ns_now / 1000000, ns_gap / 1000,
+						    ns_read / 1000, id, x, y, st);
+					}
+				}
 				if ((int64_t)lt.reports <= lt.diag || (lt.diag && lt.reports % 200 == 0)) {
 					printf("SWEET TOUCH: report %llu: %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x\n",
 					    lt.reports, r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11]);
