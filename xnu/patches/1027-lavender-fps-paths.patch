lavender: SWEET FPS line - frames shown directly or copied, and the GPU wait before direct frames

- SweetFramebuffer.cpp: counters in directPresent/present, printed with the FPS line
- made by xnu/src/mk_fpsstat.py

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index c6cf670..19f8005 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -857,6 +857,8 @@ static uint64_t sweet_fb_swap_count;
  * Frames reaching swap(), a line a second while they come: how many, the longest gap between
  * two, and how many came more than 20 ms after the one before (a vsync missed).
  */
+static uint32_t lv_fps_direct, lv_fps_copied;      /* lavender: this second's frames by path (mk_fpsstat.py) */
+static uint64_t lv_fps_gpu_abs;                    /* ... and the time spent waiting for the GPU before direct ones */
 static uint64_t sweet_fps_wait_ns, sweet_fps_after_ns;  /* this second: latch waits, tick-to-swap */
 
 static void
@@ -894,9 +896,15 @@ sweet_fps_count(void)
 	gap_max = gap > gap_max ? gap : gap_max;
 	absolutetime_to_nanoseconds(now - window, &ns);
 	if (ns >= 1000000000ull) {
+		uint64_t gpu_ns = 0;
+		absolutetime_to_nanoseconds(lv_fps_gpu_abs, &gpu_ns);
 		IOLog("SWEET FPS: %u frames in %llu ms, longest gap %llu ms, %u late; a frame: %llu us in present + latch, "
-		    "came %llu us after the tick\n", frames, ns / 1000000, gap_max / 1000000, late,
-		    frames ? sweet_fps_wait_ns / 1000 / frames : 0, frames ? sweet_fps_after_ns / 1000 / frames : 0);
+		    "came %llu us after the tick; direct %u copied %u, GPU waited %llu us a frame\n", frames, ns / 1000000,
+		    gap_max / 1000000, late,
+		    frames ? sweet_fps_wait_ns / 1000 / frames : 0, frames ? sweet_fps_after_ns / 1000 / frames : 0,
+		    lv_fps_direct, lv_fps_copied, lv_fps_direct ? gpu_ns / 1000 / lv_fps_direct : 0);
+		lv_fps_direct = lv_fps_copied = 0;
+		lv_fps_gpu_abs = 0;
 		sweet_fps_wait_ns = sweet_fps_after_ns = 0;
 		window = now;
 		frames = late = 0;
@@ -1420,7 +1428,9 @@ AppleCLCD::directPresent(const uint8_t *rec)
 		return false;
 	}
 	bool ok = false;
+	uint64_t lv_t0 = mach_absolute_time();
 	(void)topaz_surface_drawn(s, 100);
+	lv_fps_gpu_abs += mach_absolute_time() - lv_t0;
 	if (s->scanoutPhys != 0 && s->bytesPerElement == 4 &&
 	    s->width >= fWidth && s->height >= fHeight) {
 		/* full-screen surface: panel window at the logical offset */
@@ -1472,6 +1482,7 @@ AppleCLCD::directPresent(const uint8_t *rec)
 					scanFrom(pa, s->bytesPerRow);
 				}
 				ok = true;
+				lv_fps_direct++;
 				IOLockLock(fLock);
 				if (fLastSurf != s) {
 					s->retain();
@@ -1516,6 +1527,7 @@ AppleCLCD::present(const uint8_t *rec)
 		}
 		return;
 	}
+	lv_fps_copied++;
 	IOLockLock(fLock);
 	fLastVA = NULL;
 	IOLockUnlock(fLock);
