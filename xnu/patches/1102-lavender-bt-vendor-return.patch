lavender: Bluetooth control - vendor answers with return bytes (generator: xnu/src/mk_bt18.py)

diff --git a/iokit/Kernel/arm/LavenderBT.cpp b/iokit/Kernel/arm/LavenderBT.cpp
index 06b0913..033b0c8 100644
--- a/iokit/Kernel/arm/LavenderBT.cpp
+++ b/iokit/Kernel/arm/LavenderBT.cpp
@@ -666,7 +666,7 @@ ctl_up(const uint8_t *p, size_t n)
 	if (!ctl_on) {
 		return;
 	}
-	if (!(n == 7 && p[4] == 0x4c && p[5] == 0xfc) && trace_up++ < 200) {
+	if (!(n >= 7 && p[1] == 0x0e && p[4] == 0x4c && p[5] == 0xfc) && trace_up++ < 200) {
 		bt_trace("up", p, n);
 	}
 	IOLockLock(up_lock);
@@ -695,7 +695,7 @@ tx_packet(const uint8_t *p, uint32_t n)
 		}
 		if (op >= 0xFC00) {
 			/* Broadcom vendor command (boot script, calibration): done by the kernel already */
-			uint8_t cc[7] = { 0x04, 0x0e, 0x04, 0x01, p[1], p[2], 0x00 };
+			uint8_t cc[7 + 8] = { 0x04, 0x0e, 0x04 + 8, 0x01, p[1], p[2], 0x00 };
 			if (vendor_logged++ < 64) {
 				LOG("vendor %#06x (%u bytes): answered here", op, p[3]);
 			}
@@ -748,6 +748,7 @@ btc_connect(kern_ctl_ref, struct sockaddr_ctl *sac, void **)
 	ctl_unit = sac->sc_unit;
 	tx_have = 0;
 	trace_up = trace_down = 0;
+	vendor_logged = 0;
 	ctl_on = true;
 	LOG("com.apple.uart.bluetooth: connected (unit %u)", ctl_unit);
 	return 0;
