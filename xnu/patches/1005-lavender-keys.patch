diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index bb4c26b..6401c6c 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -519,6 +519,18 @@ ud_system_reset(void)
 	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
 }
 
+extern void sweet_hid_key(int key, int down);
+
+/* lv:power / lv:volup / lv:voldown / lv:home: a 120 ms press of that key (SweetHID numbering). */
+static void
+ud_press(int key)
+{
+	printf("LV USB: key %d pressed by the host\n", key);
+	sweet_hid_key(key, 1);
+	ud_sleep_ms(120);
+	sweet_hid_key(key, 0);
+}
+
 /* One command per bulk OUT packet. */
 static void
 ud_rx_done(void)
@@ -547,6 +559,14 @@ ud_rx_done(void)
 		ud_reboot_bootloader();
 	} else if (strcmp(cmd, "lv:shot") == 0) {
 		ud.shot_pending = true;
+	} else if (strcmp(cmd, "lv:power") == 0) {
+		ud_press(0);
+	} else if (strcmp(cmd, "lv:volup") == 0) {
+		ud_press(1);
+	} else if (strcmp(cmd, "lv:voldown") == 0) {
+		ud_press(2);
+	} else if (strcmp(cmd, "lv:home") == 0) {
+		ud_press(3);
 	} else {
 		printf("LV USB: unknown command \"%s\"\n", cmd);
 	}
