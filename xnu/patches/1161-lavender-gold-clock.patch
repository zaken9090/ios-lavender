+/* 0 = set; -1 = bad L or not mapped; -2 = the PLL did not lock (the cores stay on GPLL0, 600 MHz) */
+extern "C" int
+lv_gold_set_l(uint32_t l)
+{
+	static IOLock *lock;
+	uint32_t was;
