+#define RMTFS_BUF_SIZE      0x200000            /* lavender: qcom,rmtfs_sharedmem@85e00000 */
+#define RMTFS_BUF_PA        0x85E00000ull
 #define VMID_HLOS           3
 #define VMID_MSS_MSA        15
 #define VMID_NAV            0x2B
@@ -1897,12 +1898,17 @@ rmtfs_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg, const uint8_t
 	}
 	case 4: {                                   /* ALLOC_BUFF */
