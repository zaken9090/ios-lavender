lavender: Bluetooth chip-power rail (BOB pin1) and UART loopback self-test (generator: xnu/src/mk_bt2.py)

diff --git a/iokit/Kernel/arm/LavenderBT.cpp b/iokit/Kernel/arm/LavenderBT.cpp
index 5d934f4..e5b22f7 100644
--- a/iokit/Kernel/arm/LavenderBT.cpp
+++ b/iokit/Kernel/arm/LavenderBT.cpp
@@ -216,6 +216,11 @@ bt_thread(__unused void *arg, __unused wait_result_t w)
 		LOG("power %s %u uV: %s/%s", rail[i].name, rail[i].uv, a ? "ok" : "FAILED", b ? "ok" : "FAILED");
 	}
 	LOG("RF_CLK1: %s", topaz_rpm_write(0, 0x616b6c63u, 4, 0x6e657773u, 1) ? "ok" : "FAILED");
+	/* chip power: PM660L BOB pin1, 3.6 V (mk_bt2.py) */
+	bool b1 = topaz_rpm_write(0, 0x62626f62u, 1, 0x6e657773u, 1);
+	bool b2 = topaz_rpm_write(0, 0x62626f62u, 1, 0x00007675u, 3600000);
+	bool b3 = topaz_rpm_write(0, 0x62626f62u, 1, 0x31766370u, 3600000);
+	LOG("BOB (chip power): enable %s, 3.6 V %s, pin voltage 1 %s", b1 ? "ok" : "FAILED", b2 ? "ok" : "FAILED", b3 ? "ok" : "FAILED");
 	gcc = (volatile uint8_t *)ml_io_map(GCC_PA, 0x90000);
 	tlmm = (volatile uint8_t *)ml_io_map(TLMM_CENTER_PA + 0x10000, 0x4000);
 	uart = (volatile uint8_t *)ml_io_map(UART_PA, 0x1000);
@@ -226,6 +231,14 @@ bt_thread(__unused void *arg, __unused wait_result_t w)
 	}
 	bt_pins();
 	IOSleep(10);
+	/* UART self-test in internal loopback (MR2 bit 7) */
+	bt_uart_baud(0xcc);
+	wr(uart, U_MR2, rd(uart, U_MR2) | (1u << 7));
+	const uint8_t probe[4] = { 0x5a, 0xa5, 0x3c, 0xc3 };
+	bt_put(probe, 4);
+	IOSleep(5);
+	bt_drain("loopback (expect 5a a5 3c c3)", 50);
+	wr(uart, U_MR2, rd(uart, U_MR2) & ~(1u << 7));
 	uint8_t pulse = 0xC0;
 	bt_uart_baud(0x33);                                      /* 2400: divisor 192 */
 	bt_put(&pulse, 1);
