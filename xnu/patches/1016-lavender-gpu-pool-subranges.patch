 #define GPU_POOL_CHUNKS     (GPU_POOL_SIZE / GPU_POOL_CHUNK)
 static uint8_t *gpu_chunk_va[GPU_POOL_CHUNKS];
+static IOMemoryDescriptor *gpu_chunk_md[GPU_POOL_CHUNKS];  /* lavender: a chunk's descriptor, kept for good */
