+	*(uint16_t *)(a + 2) = 1;
+	*(uint16_t *)(a + 4) = 0x1000;
+	*(uint16_t *)(a + 6) = 0xFFFF;
+	*(uint32_t *)(a + 8) = 0x00010312u;
+	*(uint16_t *)(a + 12) = 2;
+	*(uint16_t *)(a + 14) = 16;
+	*(uint32_t *)(a + 16) = 48000;
+	a[20] = 1;
+	a[21] = 2;
+	if (!apr_call("ADM open", 8, 0x1000, 0x1000, 0x00010326u, a, sizeof(a), &st) || apr_got_n < 2) {
+		return false;
