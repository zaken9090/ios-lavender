+	bzero(f, sizeof(f));
+	*(uint32_t *)(f + 0) = 20;
+	*(uint16_t *)(f + 4) = 2;
+	*(uint16_t *)(f + 6) = 16;
+	*(uint32_t *)(f + 8) = 48000;
